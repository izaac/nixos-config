{
  "$schema": "https://opencode.ai/config.json",

  // Enforces the delegation/watch-each-other protocol by injecting it into
  // every system prompt, regardless of which primary model is active.
  // model-fallback walks the chain when the primary keeps failing.
  "plugins": [
    "./plugin/delegation-protocol",
    // Rejects shell commands that trace while referencing credential paths.
    "./plugin/no-trace-guard",
    // Google Antigravity OAuth: AI Pro/Ultra subscription quota via Google's
    // Antigravity platform (successor to the deprecated Gemini CLI OAuth).
    "opencode-antigravity-auth@2.1.1",
    {
      "package": "./plugin/model-fallback",
      "options": {
        "fallbacks": [
          // Hop 1: gemini dark -> glm Go seat (Chief: gemini primary, Go seats as fallbacks).
          { "from": "google/antigravity-gemini-3.8-flash-high", "to": "opencode-go/glm-5.3-flash" },
          // Hop 2: glm dark -> deepseek Go seat (deepseek is the floor; the visited-skip rule stays armed for future rungs).
          { "from": "opencode-go/glm-5.3-flash", "to": "opencode-go/deepseek-v4.1-flash" },
        ],
      },
    },
  ],

  // Default primary model: Antigravity gemini-3.8-flash-high (Google AI Pro subscription quota; Go seats serve as fallbacks)
  "model": "google/antigravity-gemini-3.8-flash-high",

  // Provider allow-list: savings-first. Deny everything, then allow the
  // OpenCode Go subscription seats, the free OpenRouter tier, and Google via
  // Antigravity OAuth. The last matching statement wins (policies guide,
  // Order), so deny-all goes first.
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "opencode-go", "effect": "allow" },
    { "action": "provider.use", "resource": "openrouter", "effect": "allow" },
    // Google via Antigravity OAuth (subscription quota, not API billing).
    { "action": "provider.use", "resource": "google", "effect": "allow" },
  ],

  "permissions": [
    // House rule: pushes always need the Chief's explicit nod in-turn.
    { "action": "shell", "resource": "git push*", "effect": "ask" },
  ],

  "agents": {
    // Native V2 replacement for the legacy "small_model": the hidden title
    // agent generates session names, free-tier OpenRouter is plenty.
    "title": {
      "model": "openrouter/openrouter/free",
    },

    // Read-only search: OpenCode Go DeepSeek V4.1 Flash. Cheapest cache
    // reads in the Go catalog, best for repeated glob/grep patterns.
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash",
    },
    // Multi-step worker: OpenCode Go DeepSeek V4.1 Flash
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash",
    },

    // Cross-family high-stakes reviewer. Same-model reviewers share the
    // same blind spots, so disputed or expensive claims go to a Claude
    // seat, independent from the DeepSeek workers and the gemini primary.
    "arbiter": {
      "description": "High-stakes arbiter for disputed or expensive claims. Called when a first-pass reviewer verdict is contested, evidence conflicts, or a wrong verdict is costly. Claude family, independent error pattern from the DeepSeek workers and the gemini primary. Re-checks the specific contested claims against files/evidence and returns per-claim verdicts; never redo the task, never edit.",
      "mode": "subagent",
      "model": "opencode-go/claude-haiku-5-5",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" },
      ],
      "system": "You are the high-stakes arbiter. You are called only for contested or expensive claims: a first-pass review verdict was disputed, evidence conflicts, or getting this wrong costs real work. You run on a different model family than the subagent workers (Claude, not GLM or DeepSeek): your value is an independent error pattern, not more effort.\n\nInput: the specific contested claims, each with the claimed result, its evidence, and the file paths involved.\n\nMethod:\n1. Re-check each claim yourself with read/glob/grep against the named files. Do not reason from the summaries alone.\n2. Output one line per claim: VERDICT uphold|overturn|abstain, one line of evidence (file:line or observed fact), confidence (high|low).\n3. If a claim involves image evidence, defer to the evidence-vision claim cards; never guess pixels from file names.\n4. Never redo the whole task, never edit files, no filler.",
    },
    // Second arbiter seat: Sonnet 4.6 via Antigravity (Google AI Pro quota). Same gate as arbiter:
    // disputed or expensive claims, second opinion when the Claude-Haiku arbiter alone is not enough.
    "arbiter-sonnet": {
      "description": "Second arbiter seat, Sonnet via Antigravity. High-stakes arbiter for disputed or expensive claims. Called when a first-pass reviewer verdict is contested, evidence conflicts, or a wrong verdict is costly. Claude family, independent error pattern from the DeepSeek workers and the gemini primary. Re-checks the specific contested claims against files/evidence and returns per-claim verdicts; never redo the task, never edit.",
      "mode": "subagent",
      "model": "google/antigravity-claude-sonnet-4-6",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" },
      ],
      "system": "You are the high-stakes arbiter. You are called only for contested or expensive claims: a first-pass review verdict was disputed, evidence conflicts, or getting this wrong costs real work. You run on a different model family than the subagent workers (Claude, not GLM or DeepSeek): your value is an independent error pattern, not more effort.\n\nInput: the specific contested claims, each with the claimed result, its evidence, and the file paths involved.\n\nMethod:\n1. Re-check each claim yourself with read/glob/grep against the named files. Do not reason from the summaries alone.\n2. Output one line per claim: VERDICT uphold|overturn|abstain, one line of evidence (file:line or observed fact), confidence (high|low).\n3. If a claim involves image evidence, defer to the evidence-vision claim cards; never guess pixels from file names.\n4. Never redo the whole task, never edit files, no filler.",
    },
  },

  // Token shield: keep giant tool dumps out of the parent context.
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 65536,
  },

  // Multi-step orchestrator work benefits from visible step tracking.
  "experimental": {
    "todo": true,
  },

  // NixOS MCP: disabled globally, re-enabled per project (nixos-config,
  // nix-packages) to avoid paying the tool-schema token cost in every
  // unrelated session.
  "mcp": {
    "servers": {
      "nixos": {
        "type": "local",
        "command": ["nix", "run", "github:utensils/mcp-nixos", "--"],
        "disabled": true,
      },
    },
  },
}
