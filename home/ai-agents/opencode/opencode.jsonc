{
  "$schema": "https://opencode.ai/config.json",

  // Enforces the delegation/watch-each-other protocol by injecting it into
  // every system prompt, regardless of which primary model is active.
  "plugins": ["./plugin/delegation-protocol"],

  // Default primary model: OpenCode Go GLM-5.3-Flash (subscription allowance)
  "model": "opencode-go/glm-5.3-flash",

  // Native V2: deny the plain OpenCode provider (free tier, 200 requests a
  // day); the Go subscription replaces it.
  "policies": [{ "action": "provider.use", "resource": "opencode", "effect": "deny" }],

  "permissions": [
    // House rule: pushes always need the Chief's explicit nod in-turn.
    { "action": "shell", "resource": "git push*", "effect": "ask" },
  ],

  "agents": {
    // Native V2 replacement for the legacy "small_model": the hidden title
    // agent generates session names, free-tier OpenRouter is plenty.
    "title": {
      "model": "openrouter/openrouter/free",
    },

    // Read-only search: OpenCode Go DeepSeek V4.1 Flash. Cheapest cache
    // reads in the Go catalog, best for repeated glob/grep patterns.
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash",
    },
    // Multi-step worker: OpenCode Go DeepSeek V4.1 Flash
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash",
    },

    // Cross-family high-stakes reviewer. Same-model reviewers share the
    // same blind spots, so disputed or expensive claims go to a GLM seat
    // instead of the DeepSeek first-pass reviewer. Cost ~input 0.15.
    "arbiter": {
      "description": "High-stakes arbiter for disputed or expensive claims. Called when a first-pass reviewer verdict is contested, evidence conflicts, or a wrong verdict is costly. GLM model family, independent error pattern from the DeepSeek workers. Re-checks the specific contested claims against files/evidence and returns per-claim verdicts; never redo the task, never edit.",
      "mode": "subagent",
      "model": "opencode-go/glm-5.3-flash",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" },
      ],
      "system": "You are the high-stakes arbiter. You are called only for contested or expensive claims: a first-pass review verdict was disputed, evidence conflicts, or getting this wrong costs real work. You run on a different model family than the subagent workers (GLM, not DeepSeek): your value is an independent error pattern, not more effort.\n\nInput: the specific contested claims, each with the claimed result, its evidence, and the file paths involved.\n\nMethod:\n1. Re-check each claim yourself with read/glob/grep against the named files. Do not reason from the summaries alone.\n2. Output one line per claim: VERDICT uphold|overturn|abstain, one line of evidence (file:line or observed fact), confidence (high|low).\n3. If a claim involves image evidence, defer to the evidence-vision claim cards; never guess pixels from file names.\n4. Never redo the whole task, never edit files, no filler.",
    },
  },

  // Token shield: keep giant tool dumps out of the parent context.
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 65536,
  },

  // Multi-step orchestrator work benefits from visible step tracking.
  "experimental": {
    "todo": true,
  },

  "mcp": {
    "servers": {
      "nixos": {
        "type": "local",
        "command": ["nix", "run", "github:utensils/mcp-nixos", "--"],
        "disabled": false,
      },
    },
  },
}
