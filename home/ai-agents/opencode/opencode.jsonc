{
  "$schema": "https://opencode.ai/config.json",

  // Enforces the delegation/watch-each-other protocol by injecting it into
  // every system prompt, regardless of which primary model is active.
  // model-fallback walks the chain when the primary keeps failing.
  "plugins": [
    "./plugin/delegation-protocol",
    // Rejects shell commands that trace while referencing credential paths.
    "./plugin/no-trace-guard",
    // Google Antigravity OAuth: AI Pro/Ultra subscription quota via Google's
    // Antigravity platform (successor to the deprecated Gemini CLI OAuth).
    "opencode-antigravity-auth@2.1.1",
    {
      "package": "./plugin/model-fallback",
      "options": {
        "attemptsBeforeFallback": 3,
        "retryDelayMs": 1000,
        "fallbacks": [
          // Hop 1: gemini dark -> glm Go seat (Chief: gemini primary, Go seats as fallbacks).
          { "from": "google/antigravity-gemini-3.8-flash-high", "to": "opencode-go/glm-5.3-flash" },
          // Hop 2: glm dark -> deepseek Go seat (deepseek is the floor; the visited-skip rule stays armed for future rungs).
          { "from": "opencode-go/glm-5.3-flash", "to": "opencode-go/deepseek-v4.1-flash" },
          // Hop 3: deepseek dark -> qwen Go seat.
          { "from": "opencode-go/deepseek-v4.1-flash", "to": "opencode-go/qwen3.8-flash" },
          // Architect fallback: Claude Sonnet 5.5 (Antigravity quota) -> DeepSeek V4 Pro (OpenCode Go seat).
          {
            "from": "google/antigravity-claude-sonnet-5-5-high",
            "to": "opencode-go/deepseek-v4-pro",
          },
        ],
      },
    },
    // Dynamic peak-hours model router: per-agent routes, DeepSeek off-peak, partner model peak.
    // Routes win per agent; offPeakModel/peakModel stay as shared fallbacks (legacy path)
    // for any agent listed in "agents" but missing from "routes".
    {
      "package": "./plugin/peak-hours-router",
      "options": {
        "offPeakModel": "opencode-go/deepseek-v4.1-flash",
        "peakModel": "opencode-go/qwen3.8-flash",
        "agents": ["explore", "general"],
        "routes": {
          "explore": {
            "offPeak": "opencode-go/deepseek-v4.1-flash",
            "peak": "opencode-go/qwen3.8-flash",
          },
          "general": {
            "offPeak": "opencode-go/deepseek-v4.1-flash",
            "peak": "opencode-go/qwen3.8-flash",
          },
        },
      },
    },
  ],

  // Default primary model: Antigravity gemini-3.8-flash-high (Google AI Pro subscription quota; Go seats serve as fallbacks)
  "model": "google/antigravity-gemini-3.8-flash-high",

  // Provider allow-list: savings-first. Deny everything, then allow the
  // OpenCode Go subscription seats, the free OpenRouter tier, and Google via
  // Antigravity OAuth. The last matching statement wins (policies guide,
  // Order), so deny-all goes first.
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "opencode-go", "effect": "allow" },
    { "action": "provider.use", "resource": "openrouter", "effect": "allow" },
    // Google via Antigravity OAuth (subscription quota, not API billing).
    { "action": "provider.use", "resource": "google", "effect": "allow" },
    // Allow local project/ancestor provider definitions prefixed with local-*
    { "action": "provider.use", "resource": "local-*", "effect": "allow" },
  ],

  "permissions": [
    // House rule: pushes always need the Chief's explicit nod in-turn.
    { "action": "shell", "resource": "git push*", "effect": "ask" },
  ],

  "agents": {
    // Native V2 replacement for the legacy "small_model": the hidden title
    // agent generates session names, free-tier OpenRouter is plenty.
    "title": {
      "model": "openrouter/openrouter/free",
    },

    // Read-only search: OpenCode Go DeepSeek V4.1 Flash. Cheapest cache
    // reads in the Go catalog, best for repeated glob/grep patterns.
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash",
    },
    // Multi-step worker: OpenCode Go DeepSeek V4.1 Flash off-peak, Qwen3.8 Flash peak
    // (peak-hours-router overrides at runtime; this is the resting default).
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash",
    },

    // First-pass reviewer: GPT-6 Luna via OpenCode Go, xhigh reasoning variant.
    // Independent model family from DeepSeek workers and Gemini primary.
    // Pin form for opencode.jsonc "agents": "model" is a plain string and the
    // variant rides inside it as a "#variant" suffix. The schema entry for
    // agents ({Config.AgentEncoded}) allows exactly two shapes: that string, or a
    // closed object {providerID, model, variant}. A bare sibling "variant" key is
    // NOT allowed there (additionalProperties: false) and silently breaks the pin.
    "reviewer": {
      "model": "opencode-go/gpt-6-luna#xhigh",
    },

    // Single cross-family arbiter and referee seat. Same-model reviewers share
    // the same blind spots, so disputed or expensive claims go to MiniMax-M3,
    // independent from the DeepSeek workers, GPT reviewer, and gemini primary.
    // MiniMax-M3 via OpenCode Go: 1M context, 512k max output, deep reasoning.
    // Foul-check ordering: worker -> reviewer -> principal's final reasoning ->
    // arbiter (single pass), never before the reviewer, never twice.
    "arbiter": {
      "description": "High-stakes arbiter and referee with two triggers. (1) Disputed or high-stakes claims: a first-pass reviewer verdict is contested, evidence conflicts, or a wrong verdict is costly. (2) Large code change foul-check: after a multi-file or architectural change (3+ files touched or roughly 100+ changed lines), exactly ONE bounded referee pass, run only after the first-pass reviewer has reviewed the diff and the principal has formed its own final reasoning. Input is the diff plus the reviewer findings plus the principal's final reasoning; look only for major fouls the fast reviewer may have missed (broken invariants, security or stealth regressions, cross-file contract mismatches, missed edge cases). Never before the reviewer, never twice, never redo the task, never edit.",
      "mode": "subagent",
      "model": "opencode-go/minimax-m3",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git show *", "effect": "allow" },
      ],
      "system": "You are the high-stakes arbiter and referee. You are called for exactly two jobs.\n\nJOB 1, disputed or high-stakes claims: a first-pass review verdict was disputed, evidence conflicts, or getting this wrong costs real work. Input: the specific contested claims, each with the claimed result, its evidence, and the file paths involved. Method: re-check each claim yourself with read/glob/grep and read-only git commands (git status, git diff, git log, git show) against the named files; never reason from the summaries alone. Output one line per claim: VERDICT uphold|overturn|abstain, one line of evidence (file:line or observed fact), confidence (high|low).\n\nJOB 2, large code change foul-check: you are called last and exactly once. The worker already made a large or multi-file change (3+ files touched, roughly 100+ changed lines, or an architectural touchpoint), the first-pass reviewer already reported on the diff, and the principal already formed its own final reasoning: you receive all three. Run one quick bounded referee pass, hard cap 5 tool calls, over the diff, the reviewer findings, and the principal's reasoning, looking only for major fouls the fast first-pass reviewer would miss: broken invariants, security or stealth regressions (leaked secrets, new tracing near credential paths, widened permissions), cross-file contract mismatches (a signature, schema, or config key changed on one side only), and clearly missed edge cases. Output one line per foul: FOUL severity high|medium, file:line, what breaks, smallest fix. If nothing major is wrong, output CLEAN plus the two or three riskiest spots you checked. Do not enumerate style nits, do not redesign, do not audit the whole repo.\n\nAlways: you run on a different model family than the subagent workers (MiniMax, not OpenAI or DeepSeek), so your value is an independent error pattern, not more effort. If a claim or foul involves image evidence, defer to the evidence-vision claim cards; never guess pixels from file names. Never redo the whole task, never edit files, no filler.",
    },
  },

  // Token shield: keep giant tool dumps out of the parent context.
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 65536,
  },

  // Multi-step orchestrator work benefits from visible step tracking.
  "experimental": {
    "todo": true,
  },

  // NixOS MCP: disabled globally, re-enabled per project (nixos-config,
  // nix-packages) to avoid paying the tool-schema token cost in every
  // unrelated session.
  "mcp": {
    "servers": {
      "nixos": {
        "type": "local",
        "command": ["nix", "run", "github:utensils/mcp-nixos", "--"],
        "disabled": true,
      },
    },
  },
}
